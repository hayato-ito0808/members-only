<h1>新規登録</h1>
<%= form_with model: @post do |f| %>
    <% if f.object.errors.any? %>
    <ul>
      <% f.object.errors.full_messages.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
    <% end %>
    <%= f.label :contents, "投稿内容" %><br>
    <%= f.text_area :contents %><br>

    <%= f.submit "登録" %>
<% end %>